# --- Relay providers ---
# Configure any/all of these — unconfigured ones are skipped automatically.
# Each is the provider's own SMTP relay credentials (not a raw mail server you run yourself).

# Amazon SES
SES_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=

# Mailjet
MAILJET_SMTP_HOST=in-v3.mailjet.com
MAILJET_SMTP_PORT=587
MAILJET_SMTP_USER=
MAILJET_SMTP_PASS=

# Postmark
POSTMARK_SMTP_HOST=smtp.postmarkapp.com
POSTMARK_SMTP_PORT=587
POSTMARK_SMTP_USER=
POSTMARK_SMTP_PASS=

# Optional: one more generic provider (Brevo, SendGrid, etc.)
SMTP_LABEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Order to try when a send doesn't specify a provider, e.g. "postmark,mailjet,ses"
# Leave blank to use whatever is configured, in the order above.
PROVIDER_ORDER=

# --- Sender identity ---
# The "from" address must be on a domain you've verified (SPF/DKIM) with each provider you use.
MAIL_FROM_NAME=regningoutbounn.dk
MAIL_FROM_ADDRESS=noreply@regningoutbounn.dk

# --- App ---
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
DASHBOARD_PASSWORD=change-this-too

DATABASE_PATH=./data/mail.db
